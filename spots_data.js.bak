// 預設推薦行程動線 (出發日期自 2027-01-13 起算；虎航岡山進出・12名城+4名湯+和牛名店+寶可夢與和平資料館)
const DEFAULT_ITINERARY = [{"baseStation":"岡山桃太郎機場 / 岡山駅","date":"2027-01-13","dayNumber":1,"deletedTransitKeys":["chiyagyu_kuya_to_okayama_aeon","okayama_aeon_to_okayama_hotel"],"lodging":"岡山站前飯店 (格蘭比亞 / 大和Roynet / 三井花園)","lodgingLocation":"JR 岡山駅東口 / 站前商圈","lodgingReason":"機場利木津巴士直達西口；千屋牛備彩在格蘭比亞2F；站前直通 AEON 商圈；次日往總社攻鬼之城起點極方便。","notes":"• 【班機抵達】：台灣虎航 IT214 於 15:05 準時降落岡山桃太郎機場 (OKJ)。出關搭中鐵/岡電機場巴士約 30 分鐘直達岡山站西口 (單程 1,000 円)。\n• 【住宿 Check-in】：進駐岡山站前飯店辦理入住手續並放下大件行李。\n• 【和牛晚餐 (岡山千屋牛)】：前往岡山格蘭比亞 2F 直結之「鉄板焼 備彩」，零距離品嚐日本最古老血統和牛——岡山千屋牛頂級鐵板燒。\n• 【商圈漫遊 & 逛街】：餐後漫步西日本最大級「AEON Mall Okayama」(營業至 21:00，350間店鋪) 採買藥妝物資，早點休息為明日名城漫遊儲備體力！","recommendedHotels":"岡山格蘭比亞大飯店 (車站直結) / 大和Roynet飯店岡山站前 (徒步2分) / 三井花園飯店岡山","spotIds":["okayama_airport","chiyagyu_kuya","okayama_aeon","okayama_hotel"],"title":"Day 1：抵達岡山・機場 ➔ 住宿 ➔ 和牛 ➔ 逛街","transitAttachments":{"okayama_airport_1":{"link":"","notes":""},"okayama_airport_to_chiyagyu_kuya":{"images":[{"isPdf":false,"name":"1790591404777.jpg","type":"image/jpeg","uploadedAt":"2026/10/3","url":"timetables/d1_okayama_airport_to_chiyagyu_kuya_1.jpg"},{"isPdf":false,"name":"1517363696-1389808805.png","type":"image/jpeg","uploadedAt":"2026/10/5","url":"timetables/d1_okayama_airport_to_chiyagyu_kuya_2.jpg"},{"isPdf":false,"name":"1517363697-3941485500.png","type":"image/jpeg","uploadedAt":"2026/10/5","url":"timetables/d1_okayama_airport_to_chiyagyu_kuya_3.jpg"}],"link":"","notes":""}}},{"baseStation":"岡山駅 / 津山駅 / 鳥取駅","date":"2027-01-14","dayNumber":2,"lodging":"鳥取站前精選飯店 (鳥取市)","lodgingLocation":"鳥取駅前 (鳥取市)","lodgingReason":"津山城攻城後搭乘 JR 因美線直達鳥取站夜宿站前飯店，省去偏遠溫泉拉車；隔天早晨零負擔從鳥取站直接啟程前往鳥取砂丘！","notes":"• 【鬼ノ城・登山步道 (建議預留 1.5~2h)】：晨間自岡山搭 JR 吉備線至總社站，搭計程車約 30 分攻登古代神秘山城鬼ノ城。山頂西門石垣與步道巡禮視野極佳，下車時務必先與司機約定下山回程時間！\n• 【津山城・平山城 (基本預留 1h)】：午後搭 JR 津山線至津山站，步行 10 分攻登津山城（鶴山公園備中櫓，園區平緩好走）。\n• 【前往鳥取站前宿】：津山城參觀後返回津山站，搭乘 JR 因美線經智頭直奔鳥取站（普通車約 1.5~2h，或搭乘特急超級因幡號），出站步行 1~3 分即達站前飯店 Check-in 卸下大件行李，晚上可在鳥取市區悠閒晚餐休息。","recommendedHotels":"鳥取站前格林豪泰酒店 (Green Hotel) / 鳥取站前超級酒店 (Super Hotel) / 鳥取市區莫里斯飯店","spotIds":["kinojo","chiyagyu_bisai","tsuyama","tottori_hotel"],"title":"Day 2：吉備古國名城鬼之城 ➔ 津山城 ➔ 抵達鳥取站前夜宿","transitAttachments":{"chiyagyu_bisai_to_tsuyama":{"images":[{"isPdf":false,"name":"1791465300281.jpg","type":"image/jpeg","uploadedAt":"2026/10/8","url":"timetables/d2_chiyagyu_bisai_to_tsuyama_1.jpg"}],"link":"","notes":"13:05/14:06/15:08 一小時一班"},"kinojo_to_chiyagyu_bisai":{"images":[{"isPdf":false,"name":"1790641253493.jpg","type":"image/jpeg","uploadedAt":"2026/10/5","url":"timetables/d2_kinojo_to_chiyagyu_bisai_1.jpg"}],"link":"","notes":""},"kinojo_to_tsuyama":{"images":[{"isPdf":false,"name":"1790596403291.jpg","type":"image/jpeg","uploadedAt":"2026/10/5","url":"timetables/d2_kinojo_to_tsuyama_1.jpg"}],"link":"","notes":""},"okayama_hotel_to_kinojo":{"images":[{"isPdf":false,"name":"1790596186537.jpg","type":"image/jpeg","uploadedAt":"2026/10/5","url":"timetables/d2_okayama_hotel_to_kinojo_1.jpg"}],"link":"","notes":""},"tsuyama_to_chiyagyu_bisai":{"images":[{"isPdf":false,"name":"1790641253493.jpg","type":"image/jpeg","uploadedAt":"2026/10/5","url":"timetables/d2_tsuyama_to_chiyagyu_bisai_1.jpg"}],"link":"","notes":""},"tsuyama_to_tottori_hotel":{"images":[{"isPdf":false,"name":"1791509643022.jpg","type":"image/jpeg","uploadedAt":"2026/10/9","url":"timetables/d2_tsuyama_to_tottori_hotel_1.jpg"}],"link":"","notes":""},"tsuyama_to_yunogo_onsen":{"images":[{"isPdf":false,"name":"1791182285031.jpg","type":"image/jpeg","uploadedAt":"2026/10/5","url":"timetables/d2_tsuyama_to_yunogo_onsen_1.jpg"}],"link":"","notes":"飯店可能5點才會到"}}},{"baseStation":"鳥取駅 / 城崎溫泉駅","date":"2027-01-15","dayNumber":3,"lodging":"城崎溫泉 和風旅館 (七大外湯巡禮/松葉蟹)","lodgingLocation":"城崎溫泉街 (兵庫縣豐岡市)","lodgingReason":"本日正式啟用 JR Pass 7日券(第1天)！晨遊鳥取城與冬季砂丘纜車，中午在站前享用和牛元祖涮涮鍋午餐後，搭乘直達特急於 14:11 抵達城崎溫泉；提早入住和風溫泉旅館，換穿浴衣木屐，享受七大外湯巡禮與冬季極品日本海松葉蟹盛宴！","notes":"• 【🎫 JR Pass 7日券啟用 第1天】：正式開通周遊券！午後搭乘「特急はまかぜ4號」直達城崎溫泉，全額免費劃位指定席！\n• 【07:50~07:55 鳥取公車前往鳥取城 (免計程車)】：鳥取站前搭乘日之丸巴士（北園團地線）於 07:50 發車，07:55 抵達「県庁日赤前」(170 円)，下車步行 4~5 分鐘於 08:00 整抵達久松公園鳥取城跡。\n• 【08:00~09:40 名城・鳥取城跡 & 仁風閣 (停留約 1.5h)】：冬季不上久松山頂，晨間散步參觀天球丸獨特圓形石垣、二之丸與仁風閣庭園外觀；09:00 準時於「仁風閣展示館」蓋取 100名城第 63 號章。\n• 【09:47~10:02 前往鳥取砂丘 (順向搭車技巧)】：自鳥取城步行至「県庁日赤前」站牌，搭乘日之丸巴士鳥取砂丘線(39系統)直奔砂丘。強烈建議在 10:00 提早於「砂丘センター展望台」下車！\n• 【10:00~11:15 冬季鳥取砂丘 & 觀光吊椅纜車 (預留約 1h15m)】：於見晴之丘展望台室內吹暖氣、居高俯瞰冬日積雪砂丘與日本海壯闊全景；搭乘單程觀光吊椅纜車（約 5 分鐘，300 円）面向大海下滑至砂丘平地入口。冬季風大不強登馬背，於前緣踩雪賞景拍照後，參觀「鳥取砂丘遊客中心(ビジターセンター)」室內地質展覽與溫水洗腳區，最後至砂丘會館採買特產。(※若遇強風纜車停駛，巴士直接坐至砂丘會館)。\n• 【11:20~11:42 返回鳥取站】：砂丘會館搭乘日之丸路線巴士返回鳥取車站 (390 円)。\n• 【11:47~12:47 日本涮涮鍋元祖「たくみ割烹店」極品午餐 (整整 1 小時)】：自鳥取站北口步行僅 4 分鐘抵達榮町「たくみ割烹店」，享用日本和牛元祖涮涮鍋「すすぎ鍋」豐盛午餐！(⚠️注意：每週三公休)。\n• 【12:56~14:11 移動至城崎溫泉 ➔ Check-in】：步行 4 分鐘返回鳥取站，搭乘 12:56 直達特急「はまかぜ4號」(JR Pass 免費)，14:11 提早抵達城崎溫泉！免轉車、舒適抵達，下午悠閒入住換穿浴衣漫步七大外湯街！(備案：若午餐較晚可搭 13:33 普通車於濱坂轉車約 15:15~15:30 抵達)。","recommendedHotels":"西村屋本館 / 城崎山名央館 (Yamanaokan) / 旅館 川口屋本館","spotIds":["tottori","tottori_sakyu","tottori_takumi","kinosaki_onsen"],"title":"Day 3：晨遊鳥取城跡 ➔ 冬季鳥取砂丘 (展望台/吊椅纜車) ➔ 和牛元祖「たくみ割烹店」午餐 ➔ 特急直達宿城崎溫泉","transitAttachments":{"hakuto_jinja_to_tottori":{"link":"","notes":"9:20-9:52"},"hakuto_jinja_to_tottori_takumi":{"link":"","notes":"15:34-16:17"},"tottori_hotel_to_hakuto_jinja":{"link":"","notes":"8:15-8:54 白兔神社9:00開 【41】白兔海岸線/https://hinomarubus.co.jp/wp/wp-content/uploads/2022/03/41%E5%B9%B3%E6%97%A5.pdf"},"tottori_hotel_to_tottori":{"link":"https://hinomarubus.co.jp/timetable_route/2661/","notes":"(44-47)湖山池線 鳥取駅\t7:35-西町\t7:42"},"tottori_hotel_to_tottori_sakyu":{"images":[{"isPdf":false,"name":"1791182958140.jpg","type":"image/jpeg","uploadedAt":"2026/10/5","url":"timetables/d3_tottori_hotel_to_tottori_sakyu_1.jpg"}],"link":"","notes":"11:30 巴士11:51 抵達「砂之美術館前」鳥取砂丘線・39號"},"tottori_sakyu_to_tottori":{"link":"","notes":"11:20-11:35/12:00-12:15"},"tottori_sakyu_to_tottori_takumi":{"link":"https://hinomarubus.co.jp/timetable_route/4185/","notes":"沙丘會館搭車回車站(39) 11:20 -11:42"},"tottori_takumi_to_kinosaki_onsen":{"images":[{"isPdf":false,"name":"1791460811449.jpg","type":"image/jpeg","uploadedAt":"2026/10/8","url":"timetables/d3_tottori_takumi_to_kinosaki_onsen_1.jpg"}],"link":"","notes":"13:33→15:28"},"tottori_to_hakuto_jinja":{"link":"","notes":"【41】白兔海岸線（往鹿野營業所方向）13:22-13:56 /15:02-15:32 "},"tottori_to_tottori_sakyu":{"link":"https://hinomarubus.co.jp/timetable_route/4185/","notes":"(39)鳥取砂丘線 西町9:47-砂丘センター展望台10:00 買票搭纜車下去沙丘入口 馬之背 "},"yunogo_onsen_to_tottori_sakyu":{"images":[{"isPdf":false,"name":"1791182958140.jpg","type":"image/jpeg","uploadedAt":"2026/10/5","url":"timetables/d3_yunogo_onsen_to_tottori_sakyu_1.jpg"}],"link":"","notes":"11:30 巴士11:51 抵達「砂之美術館前」鳥取砂丘線・39號"}}},{"baseStation":"城崎溫泉駅 / 天橋立駅 / 伊根灣 / 米子駅","date":"2027-01-16","dayNumber":4,"deletedTransitKeys":["araiso_yonago_to_yonago_hotel"],"lodging":"米子站前精選飯店 (米子市)","lodgingLocation":"JR 米子駅周邊 (米子市)","lodgingReason":"JR Pass 7日券(第2天)！包含京都丹後鐵道全線與長途特急，城崎溫泉出發遊天橋立與伊根舟屋，傍晚搭特急直達米子站，直接出站步行入住站前飯店，免拖行李轉乘公車；隔日晨間前往安來(足立美術館/月山富田城)與松江交通最極速便捷！","notes":"• 【🎫 JR Pass 第2天】：憑 Pass 免費搭乘京都丹後鐵道全線特急及山陰本線特急！\n• 【天橋立・日本三景 (建議預留 2h)】：自城崎溫泉搭京都丹後鐵道前往天橋立，搭纜車上飛龍觀眺望青松沙洲「跨下窺看」天地顛倒絕景，或漫步迴旋橋與白砂青松參道。\n• 【伊根舟屋・海之京都 (預留 2h)】：自天橋立搭丹後路線巴士約 55 分鐘抵達伊根，搭乘伊根灣遊覽船（餵海鷗、賞230棟臨海舟屋群），並於海景餐廳享用鰤魚在地料理。\n• 【傍晚移動至米子站前宿】：午後搭乘丹鐵與 JR 特急經豐岡/鳥取直達米子站，出站步行 1~3 分鐘即達站前飯店 Check-in 卸下大件行李。\n• 【米子站前名店晚餐雙推薦 (步行 2~4 分鐘直達)】：\n  - 方案 A【日本料理 荒磯 本店】：米子老字號海鮮割烹（万能町），品嚐境港活松葉蟹、紅楚蟹、炭烤喉黑魚（のどぐろ）與海鮮會席。\n  - 方案 B【居酒屋 太平記】：站前商店街超人氣第一居酒屋（明治町），境港當日朝捕活魚生魚片拼盤、大山地雞串燒與在地地酒小酌。","recommendedHotels":"米子全日空皇冠假日酒店 (ANA Crowne Plaza Yonago) / 米子華盛頓廣場飯店 / 東橫INN 米子站前 / Super Hotel 米子站前","spotIds":["amanohashidate","ine_funaya","araiso_yonago","yonago_hotel"],"title":"Day 4：日本三景天橋立 (飛龍觀/傘松公園) ➔ 伊根舟屋 (海上午餐與遊覽船) ➔ 宿米子站前 (晚餐 荒磯/太平記)","transitAttachments":{"amanohashidate_to_ine_funaya":{"link":"https://www.tankai.jp/tw/bus/tankai-bus/","notes":"編號 5 或 7 的伊根線/蒲入線-天橋立纜車11:24-伊根灣巡游觀光船 日出站11:53(不能使用IC) 船1200円///伊根の遊覧船と天橋立ケーブル・登山バスがセットに 料金 大人：1,800円"},"ine_funaya_to_araiso_yonago":{"images":[{"isPdf":false,"name":"1791510665840.jpg","type":"image/jpeg","uploadedAt":"2026/10/10","url":"timetables/d4_ine_funaya_to_araiso_yonago_1.jpg"}],"link":"https://www.tankai.jp/tw/bus/tankai-bus/","notes":"巴士13:09-14:05天橋立駅  14:34-19:47米子"},"ine_funaya_to_kaike_onsen":{"images":[{"isPdf":false,"name":"1791510665840.jpg","type":"image/jpeg","uploadedAt":"2026/10/9","url":"timetables/d4_ine_funaya_to_kaike_onsen_1.jpg"}],"link":"","notes":"11:39.13:09伊根湾めぐり・日出-12:32.14:02天橋立駅,第一班車坐回岡山了"},"ine_funaya_to_yonago_hotel":{"images":[{"isPdf":false,"name":"1791510665840.jpg","type":"image/jpeg","uploadedAt":"2026/10/9","url":"timetables/d4_ine_funaya_to_yonago_hotel_1.jpg"}],"link":"","notes":"11:39.13:09伊根湾めぐり・日出-12:32.14:02天橋立駅,第一班車坐回岡山了"},"kinosaki_onsen_to_amanohashidate":{"images":[{"isPdf":false,"name":"1791510298995.jpg","type":"image/jpeg","uploadedAt":"2026/10/9","url":"timetables/d4_kinosaki_onsen_to_amanohashidate_1.jpg"}],"link":"","notes":"7:06-8:45"}}},{"baseStation":"米子駅 / 安來駅 / 松江駅 / 玉造溫泉駅","date":"2027-01-17","dayNumber":5,"deletedTransitKeys":["tamatsukuri_yu_jinja_to_tamatsukuri_onsen"],"lodging":"玉造溫泉 和風旅館 (日本第一美肌神之湯)","lodgingLocation":"玉造溫泉街 (松江市玉湯町)","lodgingReason":"JR Pass 7日券(第3天)！松江城遊畢後可直接自南側「県民会館前」搭乘一畑巴士 P 路線(玉造線)直達玉造溫泉街(約35分，610円)免走回車站；或回松江站搭 JR 山陰本線 8 分鐘抵達。夜宿千年神湯享受美肌溫泉與會席料理！","notes":"• 【🎫 JR Pass 第3天】：涵蓋在來線與特急八雲號指定席！\n• 【月山富田城・戰國五大山城 (停留 2~2.5h)】：清晨自米子搭 JR 山陰本線至安來站，轉搭安來市營黃色巴士攻登戰國名城月山富田城，巡禮山中御殿與本丸天險。\n• 【足立美術館・連續21年日本第一庭園 (停留 1.5h)】：山麓搭黃色公車 8 分鐘直達足立美術館，透過借景枯山水庭園與橫山大觀名畫感受極致美學。\n• 【國寶松江城・現存天守 (停留 1.5h)】：搭足立免費接駁車至安來站，搭特急八雲號 14 分至松江站，搭觀光巴士至松江城登現存天守。\n• 【傍晚前往玉造溫泉 ➔ Check-in (直達巴士首選)】：松江城遊覽後，直接於松江城南側「県民会館前」站牌搭乘一畑巴士「P 路線 - 玉造線」，一車直達終點「玉造溫泉」街中心（約 32~35 分，610 円，可刷 IC 卡），免拖行李走回松江站轉電車！(備案：亦可搭市區公車回松江站，轉乘 JR 山陰本線 8 分抵玉造溫泉站，由旅館接駁車送達)。入住和風名宿，享受千年美肌神之湯與島根在地會席晚宴。","recommendedHotels":"佳翠苑 皆美 (Kasuen Minami) / 湯之助之宿 長樂園 / 白石家 (Shiraishiya)","spotIds":["gassan_toda","adachi_museum","matsue_horikawa","matsue","tamatsukuri_yu_jinja","tamatsukuri_onsen"],"title":"Day 5：戰國月山富田城 ➔ 足立美術館 ➔ 國寶松江城 ➔ 宿玉造溫泉","transitAttachments":{"adachi_museum_to_matsue":{"images":[{"isPdf":false,"name":"1791624714329.jpg","type":"image/jpeg","uploadedAt":"2026/10/10","url":"timetables/d5_adachi_museum_to_matsue_1.jpg"}],"link":"https://matsue-bus.jp/lakeline","notes":"免費巴士(售票前方桌子可以拿整理卷)12:55-13:15.13:30-13:50  //松江巴士 14:00-14:13/"},"adachi_museum_to_matsue_horikawa":{"images":[{"isPdf":false,"name":"1791635914662.jpg","type":"image/jpeg","uploadedAt":"2026/10/10","url":"data:image/jpeg;base64,"}],"link":"https://www.adachi-museum.or.jp/shuttle-bus","notes":"售票處旁有免費接駁整理卷12:00-12:20/12:30-12:50"},"gassan_toda_to_adachi_museum":{"link":"https://www.city.yasugi.shimane.jp/kurashi/sumai/yellow-bus/zikokusaisinn.html","notes":"10:32-10:39/11:20-11:29鷺の湯温泉・足立美術館前"},"matsue_horikawa_to_matsue":{"link":"https://matsue-bus.jp/lakeline","notes":"13:00-13:13/"},"matsue_to_tamatsukuri_onsen":{"link":"https://matsue-bus.jp/wp-content/uploads/2026/03/onsen-tmatsukuri-time.pdf","notes":"一般路線公車16:41-17:19 P路線-玉造線-県民会館前上車 終點玉造溫泉630 日"},"matsue_to_tamatsukuri_yu_jinja":{"images":[{"isPdf":false,"name":"1791636411145.jpg","type":"image/jpeg","uploadedAt":"2026/10/10","url":"data:image/jpeg;base64,"}],"link":"https://matsue-bus.jp/rosen_time_list2026/rosen_root_p_2026","notes":"一般巴士P路線 玉造線-国宝松江城県庁前15:39-16:19(一小時一班)/循環巴士15:13-15:48"},"yonago_hotel_to_gassan_toda":{"images":[{"isPdf":false,"name":"1791519808986.jpg","type":"image/jpeg","uploadedAt":"2026/10/9","url":"timetables/d5_yonago_hotel_to_gassan_toda_1.jpg"}],"link":"https://www.city.yasugi.shimane.jp/kurashi/sumai/yellow-bus/","notes":"巴士9:12-9:38月山入口"}}},{"baseStation":"玉造溫泉駅 / 大田市駅 / 益田駅 / 津和野駅","date":"2027-01-18","dayNumber":6,"lodging":"津和野 和風名宿 / 站前飯店 (住宿建議)","lodgingLocation":"津和野城下町 (殿町周邊 / 站前)","lodgingReason":"JR Pass 7日券(第4天)！搭乘長途特急スーパーまつかぜ與スーパーおき直達津和野，漫步紅瓦與鯉魚街道，入住小京都和風旅館，次日晨間搭纜車攻津和野城視野最佳。","notes":"• 【🎫 JR Pass 第4天】：全包山陰兩大特急指定席！\n• 【世界遺產石見銀山・龍源寺間步坑道 (停留約 3~3.5h)】：\n  - ① 交通接駁：晨間自玉造溫泉搭旅館接駁車至玉造溫泉站，搭乘 JR 特急スーパーまつかぜ約 40 分抵達「大田市站」(Pass 全包)；於站前轉搭石見交通公車（大森・銀山線，約 28 分，單程 750 円）抵達「大森」或「大森代官所跡」。\n  - ② 綠意騎行：於大森租借電動輔助自行車（約 700 円/2小時），沿林蔭緩坡騎行約 15 分鐘（2.3公里）直達「龍源寺間步」坑道口停車場（全區禁行汽車）。\n  - ③ 深入古坑道：步入江戶幕府直轄、世界遺產唯一常態開放的「龍源寺間步」（全長 273 公尺，坑內恆溫 10~13℃），近距離親睹岩壁上保存完好的手鑿痕跡（のみ跡）、垂直排水豎坑與燈明架。\n  - ④ 大森街區與午餐：單車順坡滑回大森老街，漫步紅瓦白壁古民家聚落，推薦於「群言堂 本店」享用里山庭園午餐或手打三瓶蕎麥麵。\n• 【午後搭特急直奔津和野 ➔ Check-in】：搭公車返回大田市站，搭乘特急スーパーおき直達「津和野站」(約 1h40m，Pass 全包)，入住小京都和風名宿，品嚐鄉土香魚與在地料理。","recommendedHotels":"津和野 原田屋 (Haradaya) / 若里 (Wakasato) / 益田站前飯店","spotIds":["iwami_ginzan","izumo_taisha","tsuwano_lodging"],"title":"Day 6：世界遺產石見銀山・龍源寺間步坑道 ➔ 大森街區散策 ➔ 宿津和野"},{"baseStation":"津和野駅 / 益田駅 / 東萩駅","date":"2027-01-19","dayNumber":7,"lodging":"萩市區飯店 / 萩溫泉旅館","lodgingLocation":"萩市區 / 萩城下町 / 菊濱海濱溫泉","lodgingReason":"JR Pass 7日券(第5天)！津和野登山頂山城與參拜五大稻荷，午後前往維新發祥地萩市，入住古町海濱名宿，次日清晨探訪元乃隅與萩城動線最順暢。","notes":"• 【🎫 JR Pass 第5天】：涵蓋山口線至山陰本線東萩站！\n• 【津和野城・觀光纜車與石垣絕景 (停留 2h)】：清晨搭乘單人觀光纜車輕鬆登頂津和野城跡，居高臨下俯瞰紅瓦城下町與白壁水道錦鯉街道。\n• 【太皷谷稻成神社 (停留 40m)】：山麓漫步參拜日本五大稻荷之一，穿過千本紅鳥居隧道。\n• 【前往萩市 ➔ 夜宿古町】：午後自津和野搭 JR 轉公車前往長州藩本城「萩市」，漫步城下町白壁土藏，入住溫泉名宿享用山口見島牛或長門地雞盛宴。","recommendedHotels":"北門屋敷 (Hokumon Yashiki) / 萩之宿 常茂惠 (Tomoe) / 萩溫泉景觀飯店","spotIds":["tsuwano","taikodani_inari","hagi_lodging"],"title":"Day 7：山陰小京都津和野・城下町與纜車山城 ➔ 太皷谷稻成神社 ➔ 宿萩市"},{"baseStation":"東萩駅 / 長門市駅 / 新山口駅","date":"2027-01-20","dayNumber":8,"lodging":"新山口站前飯店 (住宿建議)","lodgingLocation":"JR 新山口駅南口(新幹線口) / 北口 (Comfort Hotel / 東橫INN)","lodgingReason":"JR Pass 7日券(第6天)！晨遊元乃隅千本鳥居與長門絕壁，下午漫步世界遺產萩城；傍晚搭直達特急巴士「超級萩號 (Super Hagi)」直奔新幹線樞紐新山口站，次日晨間搭新幹線攻錦帶橋與宮島極致省時！","notes":"• 【🎫 JR Pass 第6天】：涵蓋山陰本線及中國 JR 巴士 Super Hagi 直達特急客運(免費搭乘)！\n• 【元乃隅神社・百廿三座鳥居絕壁 (建議預留 1.5h)】：晨間自萩出發前往長門市，搭乘計程車直達面臨日本海懸崖之元乃隅神社，走過 123 座紅色鳥居。\n• 【萩城跡・指月公園與古民家聚落 (建議預留 1.5h)】：午後返回萩市區，走訪長州藩毛利家指月城（100名城）、松下村塾與白壁土藏城下町。\n• 【直達特急巴士直奔新山口】：自東萩站或萩巴士中心搭乘中國 JR 巴士「Super Hagi 號」(約 60 分鐘，JR Pass 免費搭乘) 直抵新幹線樞紐新山口站，入住站前飯店。","recommendedHotels":"Comfort Hotel 新山口 / 東橫INN 新山口駅南口 / 國際飯店山口","spotIds":["motonosumi_jinja","hagi","shin_yamaguchi_lodging"],"title":"Day 8：長門斷崖絕景元乃隅神社 ➔ 長州維新世界遺產萩城 ➔ 宿新山口"},{"baseStation":"新山口駅 / 新岩國駅 / 岩國駅 / 宮島口駅 / 廣島駅","date":"2027-01-21","dayNumber":9,"lodging":"廣島站前飯店 (D9 連住第1晚)","lodgingLocation":"JR 廣島駅南口 / 站前商圈 (喜來登 / 格蘭比亞)","lodgingReason":"JR Pass 7日券啟用最後一天(第7天)！新山口搭新幹線僅 28 分到新岩國，錦帶橋＋纜車攻岩國城；午後 JR 順路直達宮島口，搭 JR 渡輪登嚴島神社賞海上鳥居；傍晚進駐廣島連住 2 晚，徹底免搬行李！","notes":"• 【🎫 JR Pass 第7天 (今日最後一日使用)】：山陽新幹線、JR山陽本線及JR宮島渡輪全額涵蓋，發揮 Pass 最終最高價值！\n• 【錦帶橋 & 岩國城・木造五連拱橋與纜車天守 (預留 2h)】：晨間自新山口搭新幹線至新岩國站，轉公車抵日本三大名橋「錦帶橋」，走過木造五連拱橋面；搭乘纜車登上橫山頂峰岩國城天守。\n• 【宮島・嚴島神社・海上大鳥居 (預留 2.5h)】：搭乘 JR 山陽本線至宮島口，憑 JR Pass 免費搭乘 JR 西日本宮島渡輪直擊海上鳥居視角，漫步世界遺產國寶神社迴廊。\n• 【傍晚進駐廣島站前飯店 (連住第 1 晚)】：自宮島口搭 JR 25 分返抵廣島站，入住站前飯店，晚餐享用在地人氣廣島燒。","recommendedHotels":"廣島喜來登大飯店 (車站直結) / 廣島格蘭比亞大飯店 (北口直結) / 廣島大和Roynet飯店","spotIds":["kintaikyo","iwakuni","itsukushima_jinja","hiroshima_lodging_d8"],"title":"Day 9：周防名橋錦帶橋・岩國城 ➔ 宮島世界遺產嚴島神社 ➔ 宿廣島"},{"baseStation":"廣島駅 / 原爆圓頂前 / 本通商圈","date":"2027-01-22","dayNumber":10,"lodging":"廣島站前飯店 (D10 連住第2晚)","lodgingLocation":"JR 廣島駅 (南口/北口站前飯店)","lodgingReason":"【⚠️ 不使用 Pass (全自費)】廣島市區深度一日漫遊，利用廣島電鐵路面電車 (均一價 220 円)；連住同間飯店免收行李，夜晚享用廣島特選頂級和牛盛宴。","notes":"• 【⚠️ 今日起不使用 JR Pass】：廣島市區景點集中，搭路面電車單程僅 220 円，直接刷 IC 卡即可。\n• 【廣島城・毛利輝元名城與廣島護國神社 (預留 1.5h)】：晨間搭路面電車前往廣島城，登黑木雕漆復原天守（鯉城），並參拜境內鎮守之廣島護國神社。\n• 【寶可夢中心廣島 & 本通商圈採買 (預留 1.5h)】：至 SOGO 廣島店 6F 探訪 Pokemon Center Hiroshima，採買鯉魚王限定周邊。\n• 【世界遺產原爆圓頂 & 和平紀念資料館 (預留 2h)】：走訪原爆圓頂歷史遺跡，漫步和平紀念公園慰靈碑，走進和平紀念資料館深思和平歷史真諦。\n• 【廣島特選和牛晚宴 (預留 1.5h)】：晚餐預約「青ひげ」品嚐廣島在地頂級「廣島牛・神石牛」牛排，或至格蘭比亞 21F 鉄板焼 神石享用高空和牛套餐！","recommendedHotels":"廣島喜來登大飯店 / 廣島格蘭比亞大飯店","spotIds":["hiroshima","hiroshima_gokoku_jinja","pokemon_center_hiroshima","atomic_bomb_dome","hiroshima_peace_museum","hiroshima_jinseki","hiroshima_lodging_d9"],"title":"Day 10：廣島和平文化・鯉城與護國神社 ➔ 原爆圓頂 ➔ 廣島和牛晚宴 (宿廣島)"},{"baseStation":"廣島駅 / 廣島巴士中心 / 福山駅 / 鞆之浦","date":"2027-01-23","dayNumber":11,"lodging":"鞆之浦溫泉 海景旅館 (福山市)","lodgingLocation":"鞆之浦古港 / 仙醉島海景露天風呂","lodgingReason":"【⚠️ 不使用 Pass (全自費)】廣島搭高速客運登吉田郡山城；下午搭新幹線自由席 23 分至福山城；福山站轉公車直達鞆之浦古港海景露天溫泉，享用瀨戶內海海鮮料理。","notes":"• 【⚠️ 今日不使用 Pass】：廣島到安藝高田為高速客運 (非 JR)；廣島到福山自費買山陽新幹線自由席 (僅 3,740 円)。\n• 【吉田郡山城・全山要塞 (建議預留 2h)】：晨間自廣島巴士中心搭客運往安藝高田，走訪戰國謀將毛利元就百萬一心之居城吉田郡山城。\n• 【福山城・鐵板張天守 (預留 1h)】：午後搭乘山陽新幹線自由席 23 分直達福山站，北口出站 1 分直達福山城，欣賞全日本唯一背面覆蓋黑鐵板之天守。\n• 【鞆之浦古港散策 & 溫泉海景夜宿】：福山站南口搭巴士 30 分直達宮崎駿《崖上的波妞》取景舞台鞆之浦，欣賞江戶時代常夜燈古港，入住海景溫泉飯店享受露天風呂與瀨戶內海海鮮盛宴。","recommendedHotels":"景勝館 漣亭 / 汀邸 遠音近音 (Ofutei) / 鷗風亭 (Hotel Osource)","spotIds":["yoshida_koriyama","fukuyama","tomonoura_onsen"],"title":"Day 11：毛利要塞吉田郡山城 ➔ 福山城 ➔ 鞆之浦夕陽溫泉"},{"baseStation":"鞆之浦 / 福山駅 / 岡山駅 / 備中高梁駅 / 備前一宮駅","date":"2027-01-24","dayNumber":12,"lodging":"岡山站前飯店 (格蘭比亞 / 大和Roynet / 三井花園)","lodgingLocation":"JR 岡山駅東口 / 站前商圈","lodgingReason":"【⚠️ 不使用 Pass (全自費)】今日移動備中松山城！晨間自鞆之浦經福山搭新幹線僅 16 分回岡山飯店放下行李；輕裝攻現存最高天守備中松山城與吉備津神社；今晚夜宿岡山站前，明日去機場極速從容！","notes":"• 【⚠️ 今日不使用 Pass】：福山到岡山新幹線自由席僅 1,770 円；岡山往備中高梁搭普通車僅 860 円 (特急自由席 1,500 円)，吉備線 150~210 円，直接購票/刷 IC 卡最經濟實惠！\n• 【09:00~10:15 鞆之浦 ➔ 福山 ➔ 岡山】：搭公車至福山站，搭新幹線自由席 16 分鐘極速直達岡山站，站前飯店 Check-in 卸下大件行李。\n• 【天空之城・備中松山城 (停留 2~2.5h)】：自岡山站搭 JR 伯備線至備中高梁站。搭乘觀光合乘計程車直達鞴峠登上海拔 430 公尺之現存最高天守備中松山城，巧遇貓城主「三十郎」！\n• 【吉備路桃太郎傳說・吉備津彥神社 & 吉備津神社 (停留 1.5h)】：下午搭 JR 伯備線/吉備線至備前一宮與吉備津站，走訪桃太郎原型神話之吉備津彥神社與擁有 398 公尺木造壯觀大迴廊之國寶吉備津神社。\n• 【傍晚返岡山採買 & 宿岡山】：返回岡山站，前往唐吉訶德、AEON Mall 與車站一番街採購名產，夜宿岡山站前！","recommendedHotels":"岡山格蘭比亞大飯店 (車站直結) / 大和Roynet飯店岡山站前 (徒步2分) / 三井花園飯店岡山","spotIds":["bitchu_matsuyama","kibitsuhiko_jinja","kibitsu_jinja","okayama_hotel"],"title":"Day 12：鞆之浦晨光 ➔ 福山新幹線 ➔ 岡山 ➔ 天空之城備中松山城 ➔ 桃太郎吉備路傳說 ➔ 宿岡山站前"},{"baseStation":"岡山駅 / 岡山桃太郎機場 (OKJ)","date":"2027-01-25","dayNumber":13,"lodging":"返抵台灣溫暖的家","lodgingLocation":"台北桃園國際機場 (TPE)","lodgingReason":"搭乘台灣虎航 IT 215 班機，15:55 起飛，17:40 抵達台北桃園第一航廈。","notes":"• 【悠閒早餐與市區最後採買】：因前晚已住在岡山站前，完全不必跨縣趕路，在車站一番街輕鬆補買岡山白桃甜點與伴手禮。\n• 【13:00 利木津巴士直達機場】：岡山站西口巴士乘車處搭乘中鐵/岡電機場巴士 (約30分鐘，單程 1,000 円自費) 直達岡山桃太郎機場 (OKJ)。\n• 【13:45 虎航櫃檯報到手續 & ✈️ 返台】：起飛前 2 小時辦理登機與行李託運，搭乘 15:55 起飛班機 (IT215) 於 17:40 順利返抵台灣桃園第一航廈 (TPE)，13天山陰山陽100名城、日本三景、世界遺產石見銀山與名湯巡禮圓滿成功！","recommendedHotels":"無 (返抵國門)","spotIds":["okayama_airport"],"title":"Day 13：岡山市區漫遊伴手禮 ➔ 岡山桃太郎機場搭機返台 (虎航 IT215)"}];

